NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bookstore:bookstore_dev_password@localhost:5432/bookstore
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PAYMENT_MODE=test
TRUST_PROXY=false

# Optional bootstrap users. Use unique, long passwords and keep this file private.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Bookstore Admin
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
